# Copy to .env and fill in. Never commit .env.

# Slack (Socket Mode)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_UI_LANG=en

# Models
OPENAI_API_KEY=
ANTHROPIC_API_KEY=          # only needed for the cross-family judge
VOLCENGINE_API_KEY=         # Seedream image generation

# Optional per-task model overrides (defaults live in config.py DEFAULT_ROUTING)
# MODEL_WRITE=gpt-4.1
# MODEL_REVIEW=gpt-4.1-mini
# MODEL_JUDGE=claude-sonnet-5

# WordPress credentials, one pair per merchant: WP_<MERCHANT_ID upper-cased>_USER / _PASSWORD
# (merchant.json only holds the site URL, never credentials)
WP_HARBOR_AUTO_SPA_USER=
WP_HARBOR_AUTO_SPA_PASSWORD=

# Scheduling / preview
TIMEZONE=America/Los_Angeles
POST_TIMES=09:00,13:00,17:00
PREVIEW_HOST=127.0.0.1
PREVIEW_BASE_URL=http://localhost:8900
